# Copia este archivo a .env y ajusta los valores. Todo es opcional: sin .env la demo funciona
# con lecturas locales y pagos simulados.

# --- General ---
PUERTO=3000
URL_PUBLICA=http://localhost:3000        # en producción: https://tu-dominio.com (Redsys/Stripe vuelven aquí)
TIRADAS_GRATIS_POR_DIA=5
PRECIO_TIRADA_COMPLETA_EUR=1
ZONA_HORARIA=Europe/Madrid
CONFIAR_PROXY=no                          # "si" si la app va detrás de un proxy (Nginx, Render, etc.)

# --- Agentes de IA (Claude) ---
ANTHROPIC_API_KEY=                        # sin clave -> lecturas locales de demostración
IA_MODELO_GRATIS=claude-opus-5-5          # agente de consultas gratuitas (claude-haiku-5-5 es ~40 veces más barato)
IA_ESFUERZO_GRATIS=low
IA_MODELO_PROFUNDO=claude-opus-5-5        # agente de lectura profunda (de pago)
IA_ESFUERZO_PROFUNDO=high                 # low | medium | high | xhigh | max

# --- Pagos ---
PAGOS_METODOS=tarjeta,bizum               # métodos que se muestran, en este orden
PAGOS_PROVEEDOR_TARJETA=simulado          # simulado | redsys | stripe
PAGOS_PROVEEDOR_BIZUM=simulado            # simulado | redsys

# Redsys (TPV virtual de tu banco: tarjeta + Bizum). Los valores por defecto son los públicos de PRUEBAS.
REDSYS_ENTORNO=pruebas                    # pruebas | real
REDSYS_CODIGO_COMERCIO=999008881
REDSYS_TERMINAL=1
REDSYS_CLAVE_SECRETA=sq7HjrUOBfKmC576ILgskD5srU870gJ7

# Stripe (solo tarjeta)
STRIPE_CLAVE_SECRETA=

# --- Tarotista por WhatsApp ---
WHATSAPP_NUMERO=34600000000               # con prefijo de país, sin + ni espacios
TAROTISTA_NOMBRE=nuestra tarotista
TAROTISTA_HORARIO=Lunes a sábado, de 10:00 a 21:00
TAROTISTA_PRECIOS=Consulta 15 min: 15 € · Consulta 30 min: 25 € · Tirada escrita personalizada: 20 €
