# Token de acceso de larga duración con permisos instagram_basic + instagram_content_publish
# (o instagram_business_basic + instagram_business_content_publish si usas "Instagram Login")
IG_ACCESS_TOKEN=
# ID de la cuenta profesional de Instagram (no es el @usuario)
IG_USER_ID=
# graph.facebook.com (cuenta vinculada a página de Facebook) o graph.instagram.com (Instagram Login)
IG_API_HOST=graph.facebook.com
IG_API_VERSION=v21.0
# Opcional: clave de imgbb.com para poder publicar imágenes guardadas en tu ordenador
IMGBB_API_KEY=
