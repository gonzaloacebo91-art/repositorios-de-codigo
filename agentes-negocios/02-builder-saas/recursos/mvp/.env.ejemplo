# Copia este archivo a .env (no lo subas al repositorio) y ajusta los valores.
PORT=3000
# URL pública con la que se generan los enlaces de los clientes
BASE_URL=http://localhost:3000
# Carpeta donde se guardan la base de datos y los archivos subidos
DATA_DIR=./data
MAX_UPLOAD_MB=20
# bandeja = no envía emails (por defecto). resend = envío real (requiere autorización A4)
MAIL_MODE=bandeja
RESEND_API_KEY=
MAIL_FROM="Recadoc <avisos@tu-dominio.es>"
